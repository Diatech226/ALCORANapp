{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","revelationType":"Meccan","ayahs":[{"n":1,"g":6208,"j":30,"p":603,"ar":"قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","fr":"Dis: «O vous les infidèles!"},{"n":2,"g":6209,"j":30,"p":603,"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","fr":"Je n'adore pas ce que vous adorez."},{"n":3,"g":6210,"j":30,"p":603,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","fr":"Et vous n'êtes pas adorateurs de ce que j'adore."},{"n":4,"g":6211,"j":30,"p":603,"ar":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","fr":"Je ne suis pas adorateur de ce que vous adorez."},{"n":5,"g":6212,"j":30,"p":603,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","fr":"Et vous n'êtes pas adorateurs de ce que j'adore."},{"n":6,"g":6213,"j":30,"p":603,"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","fr":"A vous votre religion, et à moi ma religion»."}]}