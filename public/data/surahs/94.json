{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","revelationType":"Meccan","ayahs":[{"n":1,"g":6091,"j":30,"p":596,"ar":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","fr":"N'avons-Nous pas ouvert pour toi ta poitrine?"},{"n":2,"g":6092,"j":30,"p":596,"ar":"وَوَضَعْنَا عَنكَ وِزْرَكَ","fr":"Et ne t'avons-Nous pas déchargé du fardeau"},{"n":3,"g":6093,"j":30,"p":596,"ar":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","fr":"qui accablait ton dos?"},{"n":4,"g":6094,"j":30,"p":596,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَ","fr":"Et exalté pour toi ta renommée?"},{"n":5,"g":6095,"j":30,"p":596,"ar":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","fr":"A côté de la difficulté est, certes, une facilité!"},{"n":6,"g":6096,"j":30,"p":596,"ar":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","fr":"A côté de la difficulté est, certes, une facilité!"},{"n":7,"g":6097,"j":30,"p":596,"ar":"فَإِذَا فَرَغْتَ فَٱنصَبْ","fr":"Quand tu te libères, donc, lève-toi,"},{"n":8,"g":6098,"j":30,"p":596,"ar":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","fr":"et à ton Seigneur aspire."}]}