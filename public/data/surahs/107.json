{"number":107,"name":"سُورَةُ المَاعُونِ","englishName":"Al-Maa'un","revelationType":"Meccan","ayahs":[{"n":1,"g":6198,"j":30,"p":602,"ar":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","fr":"Vois-tu celui qui traite de mensonge la Rétribution?"},{"n":2,"g":6199,"j":30,"p":602,"ar":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","fr":"C'est bien lui qui repousse l'orphelin,"},{"n":3,"g":6200,"j":30,"p":602,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","fr":"et qui n'encourage point à nourrir le pauvre."},{"n":4,"g":6201,"j":30,"p":602,"ar":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","fr":"Malheur donc, à ceux qui prient"},{"n":5,"g":6202,"j":30,"p":602,"ar":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","fr":"tout en négligeant (et retardant) leur Salât,"},{"n":6,"g":6203,"j":30,"p":602,"ar":"ٱلَّذِينَ هُمْ يُرَآءُونَ","fr":"qui sont pleins d'ostentation,"},{"n":7,"g":6204,"j":30,"p":602,"ar":"وَيَمْنَعُونَ ٱلْمَاعُونَ","fr":"et refusent l'ustensile (à celui qui en a besoin)."}]}