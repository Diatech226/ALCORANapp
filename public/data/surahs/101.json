{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","revelationType":"Meccan","ayahs":[{"n":1,"g":6158,"j":30,"p":600,"ar":"ٱلْقَارِعَةُ","fr":"Le fracas!"},{"n":2,"g":6159,"j":30,"p":600,"ar":"مَا ٱلْقَارِعَةُ","fr":"Qu'est-ce que le fracas?"},{"n":3,"g":6160,"j":30,"p":600,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","fr":"Et qui te dira ce qu'est le fracas?"},{"n":4,"g":6161,"j":30,"p":600,"ar":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","fr":"C'est le jour où les gens seront comme des papillons éparpillés,"},{"n":5,"g":6162,"j":30,"p":600,"ar":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","fr":"et les montagnes comme de la laine cardée;"},{"n":6,"g":6163,"j":30,"p":600,"ar":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","fr":"quant à celui dont la balance sera lourde"},{"n":7,"g":6164,"j":30,"p":600,"ar":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","fr":"il sera dans une vie agréable;"},{"n":8,"g":6165,"j":30,"p":600,"ar":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","fr":"et quant à celui dont la balance sera légère,"},{"n":9,"g":6166,"j":30,"p":600,"ar":"فَأُمُّهُۥ هَاوِيَةٌۭ","fr":"sa mère [destination] est un abîme très profond."},{"n":10,"g":6167,"j":30,"p":600,"ar":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","fr":"Et qui te dira ce que c'est?"},{"n":11,"g":6168,"j":30,"p":600,"ar":"نَارٌ حَامِيَةٌۢ","fr":"C'est un Feu ardent."}]}