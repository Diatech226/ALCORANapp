{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","revelationType":"Meccan","ayahs":[{"n":1,"g":6222,"j":30,"p":604,"ar":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","fr":"Dis: «Il est Allah, Unique."},{"n":2,"g":6223,"j":30,"p":604,"ar":"ٱللَّهُ ٱلصَّمَدُ","fr":"Allah, Le Seul à être imploré pour ce que nous désirons."},{"n":3,"g":6224,"j":30,"p":604,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","fr":"Il n'a jamais engendré, n'a pas été engendré non plus."},{"n":4,"g":6225,"j":30,"p":604,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","fr":"Et nul n'est égal à Lui»."}]}