{"number":114,"name":"سُورَةُ النَّاسِ","englishName":"An-Naas","revelationType":"Meccan","ayahs":[{"n":1,"g":6231,"j":30,"p":604,"ar":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","fr":"Dis: «Je cherche protection auprès du Seigneur des hommes."},{"n":2,"g":6232,"j":30,"p":604,"ar":"مَلِكِ ٱلنَّاسِ","fr":"Le Souverain des hommes,"},{"n":3,"g":6233,"j":30,"p":604,"ar":"إِلَٰهِ ٱلنَّاسِ","fr":"Dieu des hommes,"},{"n":4,"g":6234,"j":30,"p":604,"ar":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","fr":"contre le mal du mauvais conseiller, furtif,"},{"n":5,"g":6235,"j":30,"p":604,"ar":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","fr":"qui souffle le mal dans les poitrines des hommes,"},{"n":6,"g":6236,"j":30,"p":604,"ar":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","fr":"qu'il (le conseiller) soit un djinn, ou un être humain»."}]}