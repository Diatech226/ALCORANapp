{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","revelationType":"Meccan","ayahs":[{"n":1,"g":6169,"j":30,"p":600,"ar":"أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","fr":"La course aux richesses vous distrait,"},{"n":2,"g":6170,"j":30,"p":600,"ar":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","fr":"jusqu'à ce que vous visitiez les tombes."},{"n":3,"g":6171,"j":30,"p":600,"ar":"كَلَّا سَوْفَ تَعْلَمُونَ","fr":"Mais non! Vous saurez bientôt!"},{"n":4,"g":6172,"j":30,"p":600,"ar":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","fr":"(Encore une fois)! Vous saurez bientôt!"},{"n":5,"g":6173,"j":30,"p":600,"ar":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","fr":"Sûrement! Si vous saviez de science certaine."},{"n":6,"g":6174,"j":30,"p":600,"ar":"لَتَرَوُنَّ ٱلْجَحِيمَ","fr":"Vous verrez, certes, la Fournaise."},{"n":7,"g":6175,"j":30,"p":600,"ar":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","fr":"Puis, vous la verrez certes, avec l'œil de la certitude."},{"n":8,"g":6176,"j":30,"p":600,"ar":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","fr":"Puis, assurément, vous serez interrogés, ce jour-là, sur les délices."}]}