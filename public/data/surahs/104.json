{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","revelationType":"Meccan","ayahs":[{"n":1,"g":6180,"j":30,"p":601,"ar":"وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","fr":"Malheur à tout calomniateur diffamateur,"},{"n":2,"g":6181,"j":30,"p":601,"ar":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","fr":"qui amasse une fortune et la compte,"},{"n":3,"g":6182,"j":30,"p":601,"ar":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","fr":"pensant que sa fortune l'immortalisera."},{"n":4,"g":6183,"j":30,"p":601,"ar":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","fr":"Mais non! Il sera certes, jeté dans la Hutamah."},{"n":5,"g":6184,"j":30,"p":601,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","fr":"Et qui te dira ce qu'est la Hutamah?"},{"n":6,"g":6185,"j":30,"p":601,"ar":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","fr":"Le Feu attisé d'Allah"},{"n":7,"g":6186,"j":30,"p":601,"ar":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","fr":"qui monte jusqu'aux cœurs."},{"n":8,"g":6187,"j":30,"p":601,"ar":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","fr":"Il se refermera sur eux,"},{"n":9,"g":6188,"j":30,"p":601,"ar":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","fr":"en colonnes (de flammes) étendues."}]}